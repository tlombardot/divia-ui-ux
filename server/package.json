{
  "name": "diviakhaaa-server",
  "version": "1.0.0",
  "description": "Backend API & Real-time Gateway for DiviAkhaaa (Divia Dijon Transit)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "generate:network": "tsx src/scripts/generateNetworkCache.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
