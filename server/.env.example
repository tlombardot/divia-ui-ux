# Server Environment Variables Template
NODE_ENV=development
PORT=3000

# CORS & Client configuration (Comma-separated origins in production)
CORS_ORIGIN=http://localhost:8081
CLIENT_ORIGIN=http://localhost:8081

# Google Maps Platform (Routes API v2 Transit + Places API New)
# Leave empty to use local fallback engine
GOOGLE_MAPS_API_KEY=

# Socket.io & Rate Limiting
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_PING_INTERVAL_MS=25000
RATE_LIMIT_MAX_REPORTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_MS=300000

# Report TTL configuration (in milliseconds, 40 min = 2400000)
REPORT_TTL_MS=2400000

# Divia / Open Data API
DIVIA_API_URL=https://api.divia.fr
DIVIA_API_KEY=your_api_key_here
