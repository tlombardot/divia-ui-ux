# ==========================================
# DiviAkhaaa — .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Preserve template files
!.env.example

# Expo & React Native
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Build & Compilation outputs
dist/
build/
out/
*.tsbuildinfo

# Local Databases & Temporary Data
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
data.json
server/data/network-shapes-cache.json

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor temporary caches
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
