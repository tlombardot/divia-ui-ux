# Mobile (Expo / React Native) Environment Variables Template
# Laisser vide en local (mode Wi-Fi LAN pur) : l'IP du PC est détectée
# automatiquement depuis Expo Go (http://<IP_LOCALE>:3000).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
EXPO_PUBLIC_APP_ENV=development
